# Copy this file to ``agent-daemon/.env`` and fill in real values. The
# daemon loads ``.env`` automatically via ``python-dotenv`` (see
# ``config.py``). Real shell exports take precedence over .env values.

# Default inference provider for the three engines (main, analysis,
# drafting). "local" runs MLX on Apple Silicon. "groq" calls Groq's
# OpenAI-compatible endpoint instead.
AGENT_PROVIDER=local

# Per-engine overrides (local|groq); unset means "same as AGENT_PROVIDER".
# Example: keep per-event traffic on this Mac and send only tool drafts to
# Groq with AGENT_PROVIDER=local and AGENT_PROVIDER_DRAFTING=groq. An
# unknown value falls back to local with a warning. The setup scan and
# pattern detection count as cloud when AGENT_PATTERN_ENGINE's engine is.
# AGENT_PROVIDER_MAIN=
# AGENT_PROVIDER_ANALYSIS=
# AGENT_PROVIDER_DRAFTING=

# Engine the pattern recognizer uses to spot repeated workflows:
# "main" (default), "analysis" (small and fast, but weak at this) or
# "drafting".
# AGENT_PATTERN_ENGINE=main

# Logic critic that reviews each drafted tool against its spec before you
# see it (adds ~5 s per draft). Set to 0 to turn it off.
# AGENT_DRAFT_CRITIC=1

# Sandboxed dry run of each drafted tool against fixture files in a fake
# home folder (macOS sandbox-exec; skipped if unavailable). 0 turns it off.
# AGENT_DRAFT_DRY_RUN=1

# Open-ended "how could I help?" ideas. The model asks this over recent
# activity at most once per interval (seconds); a judge scores each idea
# 0-10 and only ideas at or above the minimum score are shown to you.
# Your approve/reject answers are kept in ~/.bot-inator/idea_feedback.json.
# AGENT_OPEN_HELP=1
# AGENT_OPEN_HELP_INTERVAL=600
# AGENT_OPEN_HELP_MIN_SCORE=7

# Let cloud (Groq) engines see personal text: iMessage text and email
# subjects/bodies. Off by default: that text is replaced by a placeholder in
# prompts to a cloud engine. Settings > "Let cloud models see email and
# message text" sets it too and applies at once; that saved toggle beats
# this .env line, and a shell export beats both (the toggle is then locked).
# AGENT_CLOUD_PERSONAL_TEXT=0

# Local MLX models (Hugging Face repo ids or local paths) for engines that
# run locally. Defaults are small (~14 GB total). On a 128 GB Mac:
# MLX_MAIN_MODEL=mlx-community/Qwen3.8-27B-8bit
# MLX_ANALYSIS_MODEL=mlx-community/Qwen3.6-35B-A3B-4bit
# MLX_DRAFTING_MODEL=mlx-community/KAT-Coder-V2.5-Dev-OptiQ-4bit

# Groq settings. The key is required only if some engine uses groq.
GROQ_API_KEY=
# GROQ_API_BASE=https://api.groq.com/openai/v1
# GROQ_MAIN_MODEL=openai/gpt-oss-120b
# GROQ_ANALYSIS_MODEL=openai/gpt-oss-20b
# GROQ_DRAFTING_MODEL=openai/gpt-oss-120b
